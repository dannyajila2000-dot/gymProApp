generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Gimnasio {
  id        String   @id @default(uuid())
  nombre    String
  codigo    String   @unique
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  clientes  Cliente[]
  rutinas   Rutina[]

  @@map("gimnasios")
}

model Cliente {
  id              String   @id @default(uuid())
  gimnasioId      String
  gimnasio        Gimnasio @relation(fields: [gimnasioId], references: [id])
  nombres         String
  apellidos       String
  email           String
  passwordHash    String
  telefono        String?
  alturaCm        Float?
  nivelFitness    String?  // "principiante" | "intermedio" | "avanzado"
  nivelActividad  Int?     // 0-3 (sedentario -> muy activo)
  pesoObjetivoKg  Float?
  restriccionFisica String? // "ninguna" | "impacto_bajo" | "sin_saltos"
  fechaNacimiento   DateTime?
  unidadPeso        String   @default("kg") // "kg" | "lb"
  unidadAltura      String   @default("cm") // "cm" | "in"
  preferenciaEntrenador String @default("animacion") // "animacion" | "video"
  guiaDeVozActiva Boolean @default(true)
  cuentaAtrasSeg  Int     @default(5)
  volumenMusica   Float   @default(0.5)
  bajarVolumenConVoz Boolean @default(true)
  onboardingCompletado Boolean @default(false)
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  refreshTokens         RefreshToken[]
  rutinasAsignadas      ClienteRutina[]
  sesionesEntrenamiento SesionEntrenamiento[]
  registrosProgreso     RegistroProgreso[]
  comidas               Comida[]
  registrosAgua         RegistroAgua[]
  metaNutricional       MetaNutricional?
  metaSeguimiento       MetaSeguimiento?
  feedback              Feedback[]
  recordatorios         Recordatorio[]
  registrosPasos        RegistroPasos[]
  actividadesLibres     ActividadLibre[]
  sustituciones         SustitucionEjercicio[]
  rutinasCreadas        Rutina[]

  @@unique([gimnasioId, email])
  @@map("clientes")
}

model Ejercicio {
  id                String   @id @default(uuid())
  nombre            String
  grupoMuscular     String
  tipoMedida        String   // "repeticiones" | "duracion"
  patronMovimiento  String   @default("sentadilla") // animación de muñeco a usar: sentadilla | press | remo | curl | salto | abdominal | plancha | pantorrilla
  descripcion       String?
  gifUrl            String?
  caloriasPorMinuto Float?
  esAltoImpacto     Boolean  @default(false)
  requiereSaltos    Boolean  @default(false)
  creadoEn          DateTime @default(now())

  enRutinas         RutinaEjercicio[]
  sustitutoEn       SustitucionEjercicio[]

  @@map("ejercicios")
}

model Rutina {
  id                 String   @id @default(uuid())
  gimnasioId         String
  gimnasio           Gimnasio @relation(fields: [gimnasioId], references: [id])
  nombre             String
  nivel              String   // "principiante" | "intermedio" | "avanzado"
  objetivo           String   // "fuerza" | "cardio" | "perdida_grasa" | "tren_superior" | "tren_inferior" | "cuerpo_completo"
  descripcion        String?
  imagenUrl          String?
  activa             Boolean  @default(true)
  creadoEn           DateTime @default(now())
  creadaPorClienteId String?  // null = plantilla del gimnasio; si tiene valor, es una rutina personal de ese cliente
  creadaPorCliente   Cliente? @relation(fields: [creadaPorClienteId], references: [id], onDelete: Cascade)

  ejercicios   RutinaEjercicio[]
  asignaciones ClienteRutina[]
  sesiones     SesionEntrenamiento[]

  @@map("rutinas")
}

model RutinaEjercicio {
  id           String    @id @default(uuid())
  rutinaId     String
  rutina       Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicioId  String
  ejercicio    Ejercicio @relation(fields: [ejercicioId], references: [id])
  orden        Int
  series       Int?
  repeticiones Int?
  duracionSeg  Int?
  descansoSeg  Int?

  sustituciones SustitucionEjercicio[]

  @@map("rutina_ejercicios")
}

model SustitucionEjercicio {
  id                 String          @id @default(uuid())
  clienteId          String
  cliente            Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rutinaEjercicioId  String
  rutinaEjercicio    RutinaEjercicio @relation(fields: [rutinaEjercicioId], references: [id], onDelete: Cascade)
  ejercicioId        String
  ejercicioSustituto Ejercicio       @relation(fields: [ejercicioId], references: [id])
  creadoEn           DateTime        @default(now())

  @@unique([clienteId, rutinaEjercicioId])
  @@map("sustituciones_ejercicio")
}

model ClienteRutina {
  id           String    @id @default(uuid())
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rutinaId     String
  rutina       Rutina    @relation(fields: [rutinaId], references: [id])
  asignadaPor  String?   // "auto" o id de entrenador/admin
  fechaInicio  DateTime  @default(now())
  activa       Boolean   @default(true)

  @@map("cliente_rutinas")
}

model SesionEntrenamiento {
  id                String   @id @default(uuid())
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rutinaId          String
  rutina            Rutina   @relation(fields: [rutinaId], references: [id])
  completadaEn      DateTime @default(now())
  duracionMin       Int
  caloriasEstimadas Float

  @@map("sesiones_entrenamiento")
}

model RegistroProgreso {
  id               String   @id @default(uuid())
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fecha            DateTime @default(now())
  pesoKg           Float?
  grasaCorporalPct Float?
  medidas          Json?    // { pecho, cintura, brazos, piernas, ... }
  fotoUrl          String?
  creadoEn         DateTime @default(now())

  @@map("registros_progreso")
}

model Comida {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fecha       DateTime @default(now())
  tipo        String   // "desayuno" | "almuerzo" | "cena" | "snack"
  nombre      String
  calorias    Float
  proteinaG   Float?
  carbosG     Float?
  grasaG      Float?
  creadoEn    DateTime @default(now())

  @@map("comidas")
}

model MetaNutricional {
  clienteId          String  @id
  cliente            Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  caloriasObjetivo   Float
  proteinaObjetivoG  Float?
  carbosObjetivoG    Float?
  grasaObjetivoG     Float?
  aguaObjetivoMl     Int     @default(2000)
  aguaAlarmaActiva   Boolean @default(false)
  aguaAlarmaCadaHoras Int?
  aguaVentanaInicio  String? // "HH:mm"
  aguaVentanaFin     String? // "HH:mm"

  @@map("metas_nutricionales")
}

model RegistroAgua {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fecha       DateTime @default(now())
  cantidadMl  Int

  @@map("registros_agua")
}

model MetaSeguimiento {
  clienteId              String  @id
  cliente                Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  caloriasQuemarObjetivo Int     @default(400)
  duracionObjetivoMin    Int     @default(30)
  pasosObjetivo          Int     @default(8000)
  pasosActivo            Boolean @default(false)

  @@map("metas_seguimiento")
}

model RegistroPasos {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fecha     DateTime @default(now())
  cantidad  Int

  @@map("registros_pasos")
}

model ActividadLibre {
  id                String   @id @default(uuid())
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre             String
  duracionMin        Int
  distanciaM         Float?
  caloriasEstimadas  Float
  fecha              DateTime @default(now())
  creadoEn           DateTime @default(now())

  @@map("actividades_libres")
}

model Recordatorio {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  hora       String   // "HH:mm"
  diasSemana Int[]    // 0=domingo ... 6=sábado
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  @@map("recordatorios")
}

model Feedback {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  categoria  String   // "muy_dificil" | "demasiado_facil" | "errores" | "sugerencia" | "otro"
  mensaje    String?
  creadoEn   DateTime @default(now())

  @@map("feedback")
}

model RefreshToken {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  jti        String   @unique
  expiraEn   DateTime
  creadoEn   DateTime @default(now())
  revocado   Boolean  @default(false)

  @@map("refresh_tokens")
}
